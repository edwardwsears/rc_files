#!/bin/bash

set -u

HYPRSPACE_BIN="/opt/homebrew/bin/hyprspace"
PLUGIN_DIR="$CONFIG_DIR/plugins"

if [[ ! -x "$HYPRSPACE_BIN" ]]; then
    exit 0
fi

sketchybar --bar \
    position=bottom \
    display=all \
    height=32 \
    margin=6 \
    padding_left=8 \
    padding_right=8 \
    color=0xcc181818 \
    border_width=1 \
    border_color=0x665a5a5a \
    corner_radius=9 \
    blur_radius=20 \
    topmost=window \
    sticky=on

sketchybar --default \
    icon.font="SF Pro:Semibold:14.0" \
    icon.color=0xffe8e8e8 \
    icon.padding_left=10 \
    icon.padding_right=6 \
    label.drawing=on \
    label.font="SF Pro:Regular:11.0" \
    label.color=0xffb8b8b8 \
    label.max_chars=22 \
    label.padding_left=0 \
    label.padding_right=10 \
    background.drawing=on \
    background.color=0x55353535 \
    background.border_width=1 \
    background.border_color=0x665a5a5a \
    background.corner_radius=7 \
    background.height=24 \
    padding_left=3 \
    padding_right=3

sketchybar --add event hyprspace_workspace_change

# display_change also fires when focus moves between monitors. Record the
# current count so the observer can distinguish that from a hot-plug event.
display_count_state="${TMPDIR:-/tmp}/sketchybar-display-count-${UID}.state"
sketchybar --query displays | /usr/bin/jq -r 'length' > "$display_count_state"

sketchybar --add item display_observer left \
    --set display_observer \
        drawing=off \
        script="$PLUGIN_DIR/display_change.sh" \
    --subscribe display_observer display_change

# Remove workspace items generated by an earlier config load before rebuilding
# them from Hyprspace. This prevents renamed workspaces from leaving stale tabs.
while IFS= read -r workspace_item; do
    sketchybar --remove "$workspace_item"
done < <(sketchybar --query bar | /usr/bin/jq -r '.items[] | select(startswith("space."))')

sketchybar_displays=()
while IFS= read -r display_id; do
    sketchybar_displays+=("$display_id")
done < <(sketchybar --query displays | /usr/bin/jq -r 'sort_by([.frame.x, .frame.y])[] | .["arrangement-id"]')

workspace_groups=""
for monitor_id in $("$HYPRSPACE_BIN" list-monitors --format '%{monitor-id}' 2>/dev/null); do
    display_index=$((monitor_id - 1))
    sketchybar_display="${sketchybar_displays[$display_index]:-$monitor_id}"
    visible_workspaces="$("$HYPRSPACE_BIN" list-workspaces --monitor "$monitor_id" --visible 2>/dev/null)"
    monitor_workspaces="$("$HYPRSPACE_BIN" list-workspaces --monitor "$monitor_id" 2>/dev/null)"
    workspace_group="$(printf '%s\n' "$monitor_workspaces" | /usr/bin/paste -sd, -)"
    workspace_groups="${workspace_groups:+$workspace_groups;}$workspace_group"

    for workspace in $monitor_workspaces; do
        background_color=0x55353535
        case "$workspace" in
            4-q|5-w|6-e) border_color=0xaa5e81ac ;;
            7-a|8-s|9-d) border_color=0xaaa3be8c ;;
            *) border_color=0x665a5a5a ;;
        esac
        icon_color=0xffe8e8e8
        label_color=0xffb8b8b8
        if printf '%s\n' "$visible_workspaces" | grep -qxF "$workspace"; then
            background_color=0xffff9500
            border_color=0xffffb340
            icon_color=0xff181818
            label_color=0xff303030
        fi

        sketchybar --add item "space.$workspace" left \
            --set "space.$workspace" \
                display="$sketchybar_display" \
                icon="$workspace" \
                icon.color="$icon_color" \
                label="—" \
                label.color="$label_color" \
                background.color="$background_color" \
                background.border_color="$border_color" \
                click_script="$HYPRSPACE_BIN workspace $workspace"
    done
done

sketchybar --add item hyprspace_workspace_observer left \
    --set hyprspace_workspace_observer \
        drawing=off \
        script="$PLUGIN_DIR/hyprspace_workspace.sh '$workspace_groups'" \
    --subscribe hyprspace_workspace_observer hyprspace_workspace_change

window_state="${TMPDIR:-/tmp}/sketchybar-hyprspace-windows-${UID}.state"
: > "$window_state"

sketchybar --add item hyprspace_windows_observer left \
    --set hyprspace_windows_observer \
        drawing=off \
        update_freq=30 \
        script="$PLUGIN_DIR/hyprspace_windows.sh '$workspace_groups'" \
    --subscribe hyprspace_windows_observer \
        hyprspace_workspace_change space_windows_change

layout_profile_drawing=off
layout_profile_icon="L?"
layout_profile_label="?"
layout_profile_background=0x55353535
layout_profile_border=0x665a5a5a

if (( ${#sketchybar_displays[@]} > 1 )); then
    layout_profile_drawing=on
    layout_profile="$(/usr/bin/awk '/^# Active profile: [12] / { print $4; exit }' "$HOME/.config/hyprspace/config.toml")"
    case "$layout_profile" in
        1)
            layout_profile_icon="L1"
            layout_profile_label="↔"
            ;;
        2)
            layout_profile_icon="L2"
            layout_profile_label="↕"
            layout_profile_background=0x445e81ac
            layout_profile_border=0xaa5e81ac
            ;;
    esac
fi

sketchybar --add item layout_profile right \
    --set layout_profile \
        drawing="$layout_profile_drawing" \
        icon="$layout_profile_icon" \
        icon.font="SF Pro:Semibold:12.0" \
        icon.color=0xffe8e8e8 \
        icon.padding_left=8 \
        icon.padding_right=4 \
        label="$layout_profile_label" \
        label.font="SF Pro:Semibold:13.0" \
        label.color=0xffb8b8b8 \
        label.padding_left=0 \
        label.padding_right=8 \
        background.color="$layout_profile_background" \
        background.border_color="$layout_profile_border" \
        click_script="$HOME/.config/hyprspace/switch-monitor-layout.sh toggle"

sketchybar --add item datetime right \
    --set datetime \
        icon.drawing=off \
        label.drawing=on \
        label.font="SF Pro:Semibold:12.0" \
        label.color=0xffe8e8e8 \
        label.max_chars=19 \
        label.padding_left=10 \
        label.padding_right=10 \
        update_freq=10 \
        script="$PLUGIN_DIR/datetime.sh" \
        click_script="$PLUGIN_DIR/datetime.sh toggle" \
        popup.align=right \
        popup.height=27 \
        popup.blur_radius=20 \
        popup.background.color=0xee181818 \
        popup.background.border_width=1 \
        popup.background.border_color=0x665a5a5a \
        popup.background.corner_radius=9

sketchybar --move layout_profile after datetime

for timezone in california eastern israel india; do
    sketchybar --add item "timezone.$timezone" popup.datetime \
        --set "timezone.$timezone" \
            icon="" \
            icon.font="SF Pro:Semibold:12.0" \
            icon.color=0xffe8e8e8 \
            icon.width=118 \
            icon.align=left \
            icon.padding_left=8 \
            icon.padding_right=4 \
            label="" \
            label.font="SF Pro:Medium:12.0" \
            label.color=0xffb8b8b8 \
            label.width=142 \
            label.align=right \
            label.max_chars=0 \
            label.padding_left=4 \
            label.padding_right=8 \
            background.drawing=off
done

sketchybar --subscribe datetime front_app_switched space_change

sketchybar --update
